{
  "expo": {
    "name": "kinpoyo",
    "slug": "kinpoyo",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "kinpoyo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kinpoyo.app"
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kinpoyo.app"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen",
      [
        "expo-image-picker",
        {
          "photosPermission": "投稿に写真を添付するために、写真へのアクセスを許可してください",
          "cameraPermission": "AI回数カウントでフォームを計測するために、カメラへのアクセスを許可してください",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "AI回数カウントでフォームを計測するために、カメラへのアクセスを許可してください",
          "enableMicrophonePermission": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withPoseModel",
      "expo-audio"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
